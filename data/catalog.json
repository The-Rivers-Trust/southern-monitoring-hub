  "conventions": {
    "provenanceStatus": {
      "known": "Stated by the data owner or in the service itself.",
      "inferred": "Our best reading from indirect evidence. Show it as unconfirmed.",
      "unknown": "We do not know this. The value is null and the app must say so."
    },
    "unknownText": {
      "equipment": "Equipment not recorded",
      "unit": "Unit not recorded",
      "basis": "Not recorded whether this is expressed as the whole compound or the element"
    },
    "readingKinds": {
      "exact": { "isEstimate": false, "label": "{value} {unit}" },
      "range": { "isEstimate": true, "label": "Recorded as {min}–{max} {unit}. Counted at the bottom of the range, {mapValue}." },
      "below_limit": { "isEstimate": true, "label": "Below the limit of detection, {max} {unit}. Counted as zero." },
      "below_limit_as_zero": { "isEstimate": true, "label": "Below the limit of detection, {max} {unit}. Counted as zero." },
      "above_limit": { "isEstimate": true, "label": "Beyond the limit of detection, recorded as above {min} {unit}. Counted at the limit, {mapValue}, so the true value is higher." },
      "graduation": { "isEstimate": true, "label": "Read from a graduated scale at {mapValue} {unit}. Counted at that step." }
    },
    "limits": "On a field that records its own detection limits, such as <0.03 or >2.5, the limit comes from the value. A below-limit reading counts as zero; an above-limit one counts at the limit.",
    "estimates": "A range counts at its bottom and a below-limit reading as zero, so a summary is never pushed up by a guess. A dataset with limitsAreExact (an accredited laboratory) has its limits treated as exact readings, not estimates.",
    "bands": "On a banded field every value has a band. On a number field, bands list only the special values, such as an instrument's limits, and every other value is an exact reading.",
    "scale": "Each metric's breaks are the National River Survey dashboard's agreed thresholds, as upper bounds for Low, Slightly Elevated, Elevated and High. A reading exactly on a threshold falls in the lower band. Anything above the last is Very High.",
    "observationFields": "Fields loaded with a dataset's records for uses other than a determinand, such as the scorecard's Visible Pollution signs and Wildlife sightings.",
    "toMetricUnit": "Multiply the reading by this to get the metric's unit. Null means it cannot be converted: show the raw reading and leave it out of the shared colour scale."
  },
